# macOS
.DS_Store
*.pem

# local env files — ignora qualquer variante (.env.test, .env.producao,
# .env.local, backups...), liberando só os arquivos de exemplo. A regra
# antiga listava as variantes uma a uma e deixava passar nomes novos.
.env
.env.*
!.env.example
!.env.test.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local cache/link metadata
supabase/.temp/

.vercel
