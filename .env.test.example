# Projeto Supabase separado, só para os testes de isolamento RLS
# (supabase/tests/*.test.ts) — NUNCA aponte isso para o projeto de
# produção. Copie para .env.test (gitignored) e preencha com os dados
# do projeto de teste. Precisa também ter "Confirm email" desativado em
# Authentication > Providers > Email nesse projeto, senão signUp() não
# retorna sessão e os testes falham com uma mensagem explicando isso.
TEST_SUPABASE_URL=https://SEU-PROJETO-DE-TESTE.supabase.co
TEST_SUPABASE_ANON_KEY=sua-anon-key-do-projeto-de-teste
